{
	"name": "backend",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24.11.0"
	},
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"prebuild": "rimraf dist",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/main.js",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"check": "biome check .",
		"test": "vitest",
		"test:run": "vitest run",
		"migration:run": "pnpm run build && typeorm migration:run -d dist/infrastructure/persistence/typeorm/shared/data-source.cli.js",
		"migration:revert": "pnpm run build && typeorm migration:revert -d dist/infrastructure/persistence/typeorm/shared/data-source.cli.js"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"jose": "^6.2.6",
		"pg": "^8.22.0",
		"typeorm": "^1.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^26.1.1",
		"@types/pg": "^8.20.0",
		"rimraf": "^6.1.3",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
